# InfraGuard AI — Backend Environment Configuration
# Copy this file to .env and update paths as needed

# ─── Data & Model Paths ────────────────────────────────────────────────────────
DATASET_PATH=../ongoing_project_25_26.xlsx
MODEL_PATH=../lightgbm_cost_overrun_model.pkl

# ─── Server Configuration ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ─── CORS Origins (comma-separated) ───────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── App Settings ──────────────────────────────────────────────────────────────
APP_NAME=InfraGuard AI
APP_VERSION=1.0.0
DEBUG=true

# ─── Risk Thresholds ───────────────────────────────────────────────────────────
COST_OVERRUN_THRESHOLD=0.10
ANOMALY_CONTAMINATION=0.05
